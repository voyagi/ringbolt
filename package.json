{
  "name": "ringbolt",
  "version": "0.1.0",
  "private": true,
  "description": "The on-call line that phones a human, talks through the incident, and runs the fix they authorize.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "npm run build && wrangler dev",
    "dev:client": "vite --no-open",
    "dev:scheduled": "wrangler dev --test-scheduled",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul --coverage.include=src/**/*.ts --coverage.include=src/**/*.tsx --coverage.exclude=src/**/*.test.ts --coverage.reporter=text",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "types": "wrangler types",
    "gate:types": "npm run types && tsc --noEmit",
    "gate:complexity": "eslint .",
    "gate:dup": "node node_modules/jscpd/run-jscpd.js .",
    "gate:deps": "depcruise src --config .dependency-cruiser.cjs",
    "gate:size": "size-limit",
    "gate:tree": "node scripts/check-tracked-tree.mjs",
    "gate:precommit": "eslint . && jscpd .",
    "gate": "npm run gate:types && npm run gate:complexity && npm run gate:dup && npm run gate:deps && npm run gate:tree && npm run gate:size",
    "verify:ship": "node verify-ship.mjs",
    "mutate": "stryker run",
    "fault": "vitest run --config vitest.fault.config.ts",
    "a11y:live": "node scripts/vendor/a11y-live.mjs",
    "a11y:prove": "node scripts/vendor/a11y-prove.mjs",
    "restore:rehearse": "node scripts/restore-rehearsal.mjs",
    "db:migrate:local": "wrangler d1 migrations apply ringbolt --local",
    "db:migrate:remote": "wrangler d1 migrations apply ringbolt --remote"
  },
  "dependencies": {
    "@call-e/calle": "^0.6.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "hono": "^4.13.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.3",
    "@size-limit/file": "^13.0.3",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-istanbul": "^4.1.11",
    "axe-core": "^4.13.0",
    "dependency-cruiser": "^18.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fast-check": "^4.9.0",
    "jscpd": "^5.0.16",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.8.0",
    "size-limit": "^13.0.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.123.0"
  }
}
