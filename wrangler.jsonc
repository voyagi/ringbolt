{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ringbolt",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  // The dashboard is served from the Worker itself until phase 5 builds the client bundle, at
  // which point an "assets" binding pointed at ./dist/client replaces the inline page.
  "durable_objects": {
    "bindings": [{ "name": "INCIDENT", "class_name": "IncidentDurableObject" }]
  },
  "migrations": [
    {
      // new_sqlite_classes, not new_classes: the SQLite backend is the one available on the
      // Workers free plan, and switching backends later needs a new class name.
      "tag": "v1",
      "new_sqlite_classes": ["IncidentDurableObject"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ringbolt",
      // Replaced by the real id from `wrangler d1 create ringbolt`. Local development ignores it.
      "database_id": "local-development-placeholder"
    }
  ],
  "observability": { "enabled": true },
  "vars": {
    "RINGBOLT_ENV": "development",
    "CALLE_MODE": "fake",
    "PUBLIC_BASE_URL": "http://localhost:8787"
  }
}
