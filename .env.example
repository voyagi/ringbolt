# Copy to .dev.vars for local development. Wrangler reads .dev.vars, never .env, and neither file
# is committed.

# development | preview | production
RINGBOLT_ENV=development

# fake keeps everything local and dials nothing. live places real calls through CALL-E and needs
# CALLE_API_KEY, DEMO_PHONE and CALLE_CREDIT_USD below. A call task costs five cents whether or not
# it ever connects, so leave this on fake unless you mean to spend money.
CALLE_MODE=fake

# Where CALL-E should send its webhooks. Must be reachable from the internet in live mode.
PUBLIC_BASE_URL=http://localhost:8787

# From https://dashboard.heycall-e.com/account/api-keys. Required when CALLE_MODE=live.
CALLE_API_KEY=

# The number Ringbolt calls, in E.164, for example +31612345678. Required when CALLE_MODE=live. It
# is who gets called when no rotation has been set up, and it is always allowed to be dialled.
DEMO_PHONE=

# The language the conversation is held in, as a BCP 47 tag with a region, for example en-US or
# nl-NL, and the country the telephone is in as a two letter code. Both are required when
# CALLE_MODE=live. CALL-E treats them as optional, and every call this product has ever placed
# left them out; docs/two-way-audio.md says why they are not optional here.
CALLE_LOCALE=
CALLE_REGION=

# Every number this build may ring, comma separated, for example +31612345678,+31698765432. The
# rotation can name any contact anybody adds, so this is the short list an operator writes down.
# Leave it blank and DEMO_PHONE is the only number that can be reached.
LIVE_CALL_ALLOWLIST=

# What this deployment may spend on real calls, in dollars. CALL-E bills five cents per call
# task created, connected or not. It defaults to nothing on purpose: a live build that has not
# been told what it may spend spends nothing. There is also a ceiling on the rate, three calls
# in ten minutes, which is not configurable and is the guard that catches a loop.
CALLE_CREDIT_USD=

# Shared secret in the intake URL, so only your monitors can open an incident. At least 16
# characters. Required outside development.
INTAKE_TOKEN=

# Guards everything under /api/config, which is what decides whose telephone rings. At least 16
# characters. Outside development those endpoints refuse to serve at all until this is set.
ADMIN_TOKEN=

# Every host a runbook action may call, comma separated. An action definition is a row in a
# table, so this is the short list an operator writes down, exactly as LIVE_CALL_ALLOWLIST is
# for phone numbers. Left blank in development any public host is allowed; left blank anywhere
# else no action that reaches outside can run at all, which fails towards doing nothing.
ACTION_HOST_ALLOWLIST=

# Credentials a runbook action may send. A definition names a binding rather than carrying the
# value, and only a name starting RUNBOOK_SECRET_ can be read, so a definition cannot reach the
# CALL-E key or the admin token. Add one per system Ringbolt is allowed to change.
# RUNBOOK_SECRET_DEPLOY=

# How long the local stand-in waits before a call reaches a terminal state. Fake mode only.
CALLE_FAKE_DELAY_MS=1200

# What the local stand-in does on a call: answers | no_answer | hangs_up | unparseable |
# one_way_audio. The point of a stand-in is the failure modes, so this is how the escalation and
# refusal paths are rehearsed without spending a real call. one_way_audio is the one this product
# has actually met: the responder's turns come back empty, and nothing may be acted on. Fake mode
# only.
CALLE_FAKE_SCENARIO=answers
