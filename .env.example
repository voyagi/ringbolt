# Copy to .dev.vars for local development. Wrangler reads .dev.vars, never .env, and neither file
# is committed.

# development | preview | production
RINGBOLT_ENV=development

# fake keeps everything local and dials nothing. It is the only value this build accepts: live is
# refused when the configuration is read, because the CALL-E adapter is not written yet, and a
# setting that is accepted and then cannot work is worse than one that is refused outright.
CALLE_MODE=fake

# Where CALL-E should send its webhooks. Must be reachable from the internet once live mode exists.
PUBLIC_BASE_URL=http://localhost:8787

# From https://dashboard.heycall-e.com/account/api-keys. Not read until the CALL-E adapter lands.
CALLE_API_KEY=

# Shared secret in the intake URL, so only your monitors can open an incident. At least 16
# characters. Required outside development.
INTAKE_TOKEN=

# How long the local stand-in waits before a call reaches a terminal state. Fake mode only.
CALLE_FAKE_DELAY_MS=1200
