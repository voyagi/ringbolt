# Copy to .dev.vars for local development. Wrangler reads .dev.vars, never .env, and neither file
# is committed.

# development | preview | production
RINGBOLT_ENV=development

# fake keeps everything local and dials nothing. live places real calls through CALL-E and needs
# both CALLE_API_KEY and DEMO_PHONE below. The free allowance is twenty calls in total and there is
# no twenty first, so leave this on fake unless you mean to spend one.
CALLE_MODE=fake

# Where CALL-E should send its webhooks. Must be reachable from the internet in live mode.
PUBLIC_BASE_URL=http://localhost:8787

# From https://dashboard.heycall-e.com/account/api-keys. Required when CALLE_MODE=live.
CALLE_API_KEY=

# The number Ringbolt calls, in E.164, for example +31612345678. Required when CALLE_MODE=live, and
# it is the only number dialled until the rotation lands.
DEMO_PHONE=

# Shared secret in the intake URL, so only your monitors can open an incident. At least 16
# characters. Required outside development.
INTAKE_TOKEN=

# How long the local stand-in waits before a call reaches a terminal state. Fake mode only.
CALLE_FAKE_DELAY_MS=1200
