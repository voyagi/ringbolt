# Copy to .dev.vars for local development. Wrangler reads .dev.vars, never .env, and neither file
# is committed.

# development | preview | production
RINGBOLT_ENV=development

# fake keeps everything local and dials nothing. live places real calls through CALL-E and needs
# both CALLE_API_KEY and DEMO_PHONE below. The free allowance is twenty calls in total and there is
# no twenty first, so leave this on fake unless you mean to spend one.
CALLE_MODE=fake

# Where CALL-E should send its webhooks. Must be reachable from the internet in live mode.
PUBLIC_BASE_URL=http://localhost:8787

# From https://dashboard.heycall-e.com/account/api-keys. Required when CALLE_MODE=live.
CALLE_API_KEY=

# The number Ringbolt calls, in E.164, for example +31612345678. Required when CALLE_MODE=live. It
# is who gets called when no rotation has been set up, and it is always allowed to be dialled.
DEMO_PHONE=

# Every number this build may ring, comma separated, for example +31612345678,+31698765432. The
# rotation can name any contact anybody adds, so this is the short list an operator writes down.
# Leave it blank and DEMO_PHONE is the only number that can be reached.
LIVE_CALL_ALLOWLIST=

# Shared secret in the intake URL, so only your monitors can open an incident. At least 16
# characters. Required outside development.
INTAKE_TOKEN=

# Guards everything under /api/config, which is what decides whose telephone rings. At least 16
# characters. Outside development those endpoints refuse to serve at all until this is set.
ADMIN_TOKEN=

# How long the local stand-in waits before a call reaches a terminal state. Fake mode only.
CALLE_FAKE_DELAY_MS=1200

# What the local stand-in does on a call: answers | no_answer | hangs_up | unparseable. The point
# of a stand-in is the failure modes, so this is how the escalation and refusal paths are rehearsed
# without spending a real call. Fake mode only.
CALLE_FAKE_SCENARIO=answers
