{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "reporters": ["html", "clear-text", "progress"],
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/{money,pricing,price,billing,invoice,ledger,tax,discount,cart,checkout,order,payment,refund,fee,total,subtotal,amount,currency,coupon,balance,quote,parse,format,calc}*.{ts,tsx}",
    "!src/**/*.test.*",
    "!src/**/*.spec.*",
    "!src/**/*.d.ts"
  ],
  "incremental": true,
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": null },
  "vitest": { "configFile": "vitest.config.ts" }
}
